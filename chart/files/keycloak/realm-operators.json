{
  "realm": {{ .Values.platform.keycloak.realms.operators.name | quote }},
  {{- with .Values.platform.keycloak.realms.operators.loginTheme }}
  "loginTheme": {{ . | quote }},
  {{- end }}
  "enabled": true,
  "displayName": "AIsolate",
  "sslRequired": "external",
  "roles": {
    "realm": [
      {
        "name": "aisolate-admin",
        "description": "AIsolate UI: creates spaces and names the developers and the roles that may ask; may do everything"
      },
      {
        "name": "aisolate-auditor",
        "description": "AIsolate UI: reads the audit trail and nothing else"
      },
      {
        "name": "offline_access",
        "description": "Offline tokens: the CLI's login outlives the browser session"
      }
    ]
  },
{{ .Files.Get "files/keycloak/client-scopes.json" | trimSuffix "\n" }}
  "defaultDefaultClientScopes": [
    "profile",
    "email",
    "roles",
    "web-origins",
    "acr",
    "basic",
    "aisolate"
  ],
  "defaultOptionalClientScopes": [
    "address",
    "phone",
    "offline_access",
    "microprofile-jwt",
    "organization"
  ],
  "clients": [
    {
      "clientId": "aisolate-ui",
      "name": "AIsolate UI",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "directAccessGrantsEnabled": true,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "{{ include "aisolate.scheme" . }}://{{ .Values.platform.frontend.host }}"
      },
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "realm-roles-in-id-token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email",
        "aisolate"
      ],
      "rootUrl": "{{ include "aisolate.scheme" . }}://{{ .Values.platform.frontend.host }}",
      "baseUrl": "{{ include "aisolate.scheme" . }}://{{ .Values.platform.frontend.host }}",
      "redirectUris": [
        "{{ include "aisolate.scheme" . }}://{{ .Values.platform.frontend.host }}/*"
      ],
      "webOrigins": [
        "{{ include "aisolate.scheme" . }}://{{ .Values.platform.frontend.host }}"
      ]
    },
    {
      "clientId": "aisolate-cli",
      "name": "AIsolate CLI",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "realm-roles-in-id-token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email",
        "aisolate"
      ],
      "description": "aisolate login: browser sign-in with PKCE and a loopback redirect (RFC 8252)",
      "redirectUris": [
        "http://127.0.0.1/*"
      ],
      "optionalClientScopes": [
        "offline_access"
      ]
    }
  ]{{- if .Values.platform.keycloak.demoUsers }},
  "users": [
    {
      "username": "admin",
      "email": "admin@example.com",
      "firstName": "Admin",
      "lastName": "Doe",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${ADMIN_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "aisolate-admin"
      ]
    },
    {
      "username": "developer",
      "email": "developer@example.com",
      "firstName": "Developer",
      "lastName": "Doe",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${DEVELOPER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": []
    },
    {
      "username": "auditor",
      "email": "auditor@example.com",
      "firstName": "Auditor",
      "lastName": "Doe",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${AUDITOR_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "aisolate-auditor"
      ]
    }
  ]
{{- end }}
}
